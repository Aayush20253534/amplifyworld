NEXT_PUBLIC_API_URL=http://localhost:4000
# Public, verified business WhatsApp number in international format (digits, optional leading +).
# When unset or invalid, WhatsApp CTAs remain visibly unavailable and never link to a made-up number.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# The API currently supports /health only. Setting NEXT_PUBLIC_API_URL does not
# enable inquiry submission; the real adapter and server controls arrive in Modules 11–13.
